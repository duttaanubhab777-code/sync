# ---------- সার্ভার ----------
PORT=5000
# Render-এ NODE_ENV=production দাও
NODE_ENV=development
# proxy-র পেছনে (Render) 1। Render-এ না দিলেও নিজে থেকে 1 ধরা হয়
TRUST_PROXY=1

# ---------- MongoDB ----------
MONGODB_URI=

# ---------- JWT (Python সার্ভিসের JWT_SECRET-এর সাথে হুবহু এক) ----------
JWT_SECRET=
JWT_EXPIRES_IN=15m
# আলাদা একটা secret দাও (না দিলে JWT_SECRET-ই ব্যবহার হবে)
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRY=30d

# ---------- Frontend ----------
# frontend/ ফোল্ডার এই সার্ভিস থেকেই serve হয়, তাই প্রোডাকশনে এটা ফাঁকা রাখো।
# লোকাল ডেভেলপমেন্টে frontend আলাদা পোর্টে চালালে সেই origin দাও (কমা দিয়ে একাধিক)
FRONTEND_URL=
# frontend অন্য ফোল্ডারে রাখলে তার পথ (ঐচ্ছিক, ডিফল্ট: ../frontend)
FRONTEND_DIR=
# frontend-এ inline <script> বা onclick="..." থাকলে true করো (নিরাপত্তার জন্য ছোট ফাইলে আলাদা .js রাখাই ভালো)
ALLOW_INLINE_SCRIPTS=false

# ---------- Cloudinary / Python ----------
CLOUDINARY_CLOUD_NAME=
# app থেকে কিছু ডিলিট করলে Cloudinary থেকেও ফাইল মুছতে এই দুটো লাগে (Cloudinary Dashboard > API Keys)
# না দিলে ফাইল মোছা বাদ যায় (অ্যাপ ঠিকই চলে), কিন্তু Cloudinary-র স্টোরেজ ভরতে থাকবে
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Python সার্ভিসের (PythonAnywhere) ঠিকানা: CSP-তে connect-src হিসেবে খোলা হয়
PYTHON_SERVICE_URL=
# ---------- Signup OTP ইমেইল (Python mail relay) ----------
# PythonAnywhere config.py-র MAIL_RELAY_SECRET-এর সাথে হুবহু এক (কমপক্ষে ২৪ অক্ষর)
MAIL_RELAY_SECRET=
# ঐচ্ছিক: OTP hash-এর আলাদা secret (না দিলে JWT_SECRET ব্যবহার হবে)
OTP_SECRET=
# ঐচ্ছিক (ডিফল্ট): কোডের মেয়াদ মিনিটে / পরপর পাঠানোর বিরতি সেকেন্ডে / এক signup-এ সর্বোচ্চ কতবার পাঠানো / ভুল কোডের সর্বোচ্চ চেষ্টা
# OTP_EXPIRES_MINUTES=10
# OTP_RESEND_COOLDOWN_SECONDS=60
# OTP_MAX_SENDS=5
# OTP_MAX_ATTEMPTS=5
# লোকালে MAIL_RELAY_SECRET না দিলে OTP টার্মিনালে ছাপা হয় (প্রোডাকশনে এটা কাজ করে না)

# SERVICE_KEY এখন ব্যবহার হয় না (ভবিষ্যতের /scan-এর জন্য রাখা ছিল), তাই দিতে হবে না

# ---------- Contact page (Email Sender) ----------
# Contact ফর্ম এই ঠিকানায় POST করে; CSP connect-src-তে এটা খোলা হয় (না দিলে নিচের ডিফল্ট)
# EMAIL_SENDER_URL=https://email-sender-wy5o.onrender.com

# ---------- ঐচ্ছিক ----------
# এই ইমেইলে register করলে ইউজার Super Admin হয়ে যায়
SUPER_ADMIN_EMAIL=

# ---------- Web Push Notifications (ব্রাউজার / PWA) ----------
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:sync93346@gmail.com

# ---------- Android App Push Notifications (Firebase Cloud Messaging) ----------
# উপায় ১ (সবচেয়ে সহজ): Firebase Console → Project settings → Service accounts → Generate new private key
# থেকে ডাউনলোড করা পুরো .json ফাইলটার ভেতরের লেখাটা হুবহু FIREBASE_SERVICE_ACCOUNT_JSON-এ পেস্ট করো:
FIREBASE_SERVICE_ACCOUNT_JSON=
# উপায় ২: অথবা ওই ডাউনলোড করা JSON ফাইল থেকে এই ৩টি মান আলাদা করে বসাতে পারো:
FIREBASE_PROJECT_ID=sync-34886
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Android অ্যাপের "Update available" ও Version history GitHub Releases থেকে আসে (ঐচ্ছিক, না দিলে default repo)
# GITHUB_REPO=duttaanubhab777-code/sync
# GITHUB_TOKEN=   # শুধু private repo হলে

# ---------- Android অ্যাপ আপডেট নোটিফিকেশন ("Update Now" বাটনসহ) ----------
# GitHub Actions নতুন APK release দেওয়ার পর এই secret দিয়ে সার্ভারকে জানায় (POST /api/v1/app/updates/notify)।
# একটা লম্বা এলোমেলো লেখা দাও; GitHub repo secret APP_UPDATE_NOTIFY_SECRET-এও একই মান দিতে হবে।
# secret না দিলেও চলে: সার্ভার নিজেই প্রতি ৫ মিনিটে GitHub-এ নতুন release খোঁজে।
APP_UPDATE_NOTIFY_SECRET=
# APP_UPDATE_POLL_MS=300000
# APP_UPDATE_WATCHER=off   # নিজে থেকে খোঁজা বন্ধ করতে

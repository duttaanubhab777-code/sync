# ---------- সার্ভার ----------
PORT=5000
# Render-এ NODE_ENV=production দাও
NODE_ENV=development
# proxy-র পেছনে (Render) 1। Render-এ না দিলেও নিজে থেকে 1 ধরা হয়
TRUST_PROXY=1

# ---------- MongoDB ----------
MONGODB_URI=

# ---------- JWT (Python সার্ভিসের JWT_SECRET-এর সাথে হুবহু এক) ----------
JWT_SECRET=
JWT_EXPIRES_IN=15m
# আলাদা একটা secret দাও (না দিলে JWT_SECRET-ই ব্যবহার হবে)
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRY=30d

# ---------- Frontend ----------
# frontend/ ফোল্ডার এই সার্ভিস থেকেই serve হয়, তাই প্রোডাকশনে এটা ফাঁকা রাখো।
# লোকাল ডেভেলপমেন্টে frontend আলাদা পোর্টে চালালে সেই origin দাও (কমা দিয়ে একাধিক)
FRONTEND_URL=
# frontend অন্য ফোল্ডারে রাখলে তার পথ (ঐচ্ছিক, ডিফল্ট: ../frontend)
FRONTEND_DIR=
# frontend-এ inline <script> বা onclick="..." থাকলে true করো (নিরাপত্তার জন্য ছোট ফাইলে আলাদা .js রাখাই ভালো)
ALLOW_INLINE_SCRIPTS=false

# ---------- Cloudinary / Python ----------
CLOUDINARY_CLOUD_NAME=
# Python সার্ভিসের (PythonAnywhere) ঠিকানা: CSP-তে connect-src হিসেবে খোলা হয়
PYTHON_SERVICE_URL=
# SERVICE_KEY এখন ব্যবহার হয় না (ভবিষ্যতের /scan-এর জন্য রাখা ছিল), তাই দিতে হবে না

# ---------- ঐচ্ছিক ----------
# এই ইমেইলে register করলে ইউজার Super Admin হয়ে যায়
SUPER_ADMIN_EMAIL=

# ---------- Web Push Notifications ----------
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:sync93346@gmail.com

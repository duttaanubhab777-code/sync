# প্রোডাকশনে (Render একই Web Service) VITE_API_BASE_URL ফাঁকা রাখবে কারণ একই origin থেকে /api ও /socket.io চলে।
VITE_API_BASE_URL=

# Python সার্ভিসের (PythonAnywhere) URL — না দিলেও সমস্যা নেই, কারণ ব্যাকএন্ডের /health থেকেই স্বয়ংক্রিয়ভাবে নিয়ে নেয়।
VITE_PYTHON_SERVICE_URL=

# লোকাল ডেভেলপমেন্টে ব্যাকএন্ড অন্য পোর্টে চললে (ডিফল্ট: http://localhost:5000)
VITE_BACKEND_PROXY=http://localhost:5000
